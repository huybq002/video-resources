 "scenes": [
  {
   "id": 1,
   "title": "The Oven At Eleven",
   "goal": "Maya cleans anything but the work",
   "target_s": 20,
   "shots": [
    {
     "sequence": {
      "type": "narration",
      "settings": [
       "kitchen_night",
       "desk_room"
      ],
      "mood": "funny",
      "seed": 1,
      "actors": [
       {
        "k": "maya",
        "x": 960
       }
      ],
      "cues": [
       "At eleven p.m., Maya is scrubbing a spotless oven.",
       "She never cooks. Her talk is due at nine.",
       "The first slide is still blank, and she knows exactly why.",
       "By the end, you will see what she is really cleaning away.",
       "And why you do it too."
      ]
     }
    }
   ]
  },
  {
   "id": 2,
   "title": "One Blank Slide",
   "goal": "The task and the feeling",
   "target_s": 25,
   "shots": [
    {
     "sequence": {
      "type": "narration",
      "settings": [
       "desk_room"
      ],
      "mood": "tense",
      "seed": 2,
      "actors": [
       {
        "k": "maya",
        "x": 960
       }
      ],
      "cues": [
       "Maya sits down at her desk, opens the file, and looks at the title.",
       "The cursor blinks. Her stomach does something small and unpleasant.",
       "It is not fear of failing tonight. It is a quieter feeling.",
       "A tightness, a little hum of not yet knowing how to start.",
       "She closes the laptop gently, like closing a door on a sleeping dog."
      ]
     }
    }
   ]
  },
  {
   "id": 3,
   "title": "Just Resetting",
   "goal": "Theo notices",
   "target_s": 25,
   "shots": [
    {
     "sequence": {
      "type": "dialogue",
      "setting": "kitchen_night",
      "mood": "funny",
      "seed": 3,
      "a": {
       "k": "maya",
       "x": 560
      },
      "b": {
       "k": "theo",
       "x": 1360
      },
      "lines": [
       {
        "who": "theo",
        "t": "It is eleven thirty. Why are you defrosting the freezer right now?"
       },
       {
        "who": "maya",
        "t": "I am resetting my environment. I cannot think in a messy kitchen."
       },
       {
        "who": "theo",
        "t": "Your kitchen was clean at lunch. I watched you wipe the tap."
       },
       {
        "who": "maya",
        "t": "Then the bathroom. Then the inbox. Then I will start, I promise."
       },
       {
        "who": "theo",
        "t": "You said that three nights ago, and the nights before that."
       }
      ]
     }
    }
   ]
  },
  {
   "id": 4,
   "title": "The Laundry Detour",
   "goal": "Every chore pays a small reward",
   "target_s": 25,
   "shots": [
    {
     "sequence": {
      "type": "narration",
      "settings": [
       "laundromat"
      ],
      "mood": "warm",
      "seed": 4,
      "actors": [
       {
        "k": "maya",
        "x": 960
       }
      ],
      "cues": [
       "Maya takes her laundry down to the machines in the basement.",
       "She folds every shirt twice and sorts her socks by colour.",
       "And here is the odd thing: she feels better with each sock.",
       "The tightness loosens a little every time she steps away from the slide.",
       "Nobody told her this was a trap. It feels like being productive."
      ]
     }
    }
   ]
  },
  {
   "id": 5,
   "title": "The Mood Fix",
   "goal": "The mechanism",
   "target_s": 30,
   "shots": [
    {
     "sequence": {
      "type": "narration",
      "settings": [
       "mind_room"
      ],
      "mood": "tense",
      "seed": 5,
      "actors": [
       {
        "k": "maya",
        "x": 960
       }
      ],
      "cues": [
       "Researchers have a plain name for what is happening: short term mood repair.",
       "The task makes an unpleasant feeling. Avoiding the task turns that feeling off, fast.",
       "And the brain quietly learns a lesson: dodging works, so do it again.",
       "Notice what is being avoided. It is not the slides, it is the feeling.",
       "That is why a dull chore always beats a hard task, until the clock wins."
      ],
      "crowd": {
       "n": 22,
       "x": [
        0.04,
        0.96
       ],
