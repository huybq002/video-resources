# Sao chép thành .env rồi sửa:  cp .env.example .env
# start.sh / start.bat tự nạp file này. Biến đã export sẵn trong shell sẽ được ưu tiên.
# API key AI KHÔNG đặt ở đây: nhập ở Studio > Settings (lưu tại .studio-data/settings/ai.json, đã gitignore).

# --- Studio ---
STUDIO_HOST=127.0.0.1
STUDIO_PORT=7863
# Số job chạy song song (1-4). TTS vẫn tuần tự hóa.
STUDIO_WORKERS=3

# --- Whiteboard engine (repo srt-whiteboard-animation) ---
WHITEBOARD_ROOT=H:/Tool/video-generate/srt-whiteboard-animation
WHITEBOARD_PYTHON=H:/Tool/video-generate/srt-whiteboard-animation/.venv/Scripts/python.exe
# Tùy chọn: ảnh cây bút ("none" để tắt), FPS mặc định, pause giữa nét vẽ, cạnh dài tối đa.
# WHITEBOARD_PEN=
# WHITEBOARD_FPS=60
# WHITEBOARD_PAUSE=off
# WHITEBOARD_LONG_EDGE=

# --- HyperFrames (tùy chọn, tăng tốc render) ---
# HF_RENDER_QUALITY=draft
# HF_RENDER_WORKERS=4
# HF_RENDER_FPS=30

# --- Python dùng để chạy Studio (mặc định tự tìm .venv) ---
# PYTHON=H:/Tool/code2video/.venv/Scripts/python.exe
