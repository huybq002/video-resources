  "scenes": [
    {
      "id": 1,
      "title": "The Morning Nobody Answered",
      "goal": "You wake to a dead city and see the first of them.",
      "target_s": 24,
      "shots": [
        {
          "sequence": {
            "type": "narration",
            "settings": [
              "ruined_street"
            ],
            "mood": "tense",
            "seed": 1,
            "actors": [
              {
                "k": "you",
                "x": 470
              }
            ],
            "crowd": {
              "n": 26,
              "x": [
                0.03,
                0.97
              ],
              "by": [
                0.6,
                0.84
              ],
              "s": [
                0.16,
                0.34
              ],
              "seed": 4,
              "colors": [
                "#5d6b55",
                "#6f5f4e"
              ]
            },
            "cues": [
              "Six in the morning. Nobody in the city is awake.",
              "No engines, no radios, no neighbour shouting at his dog downstairs.",
              "Your phone shows four hundred missed calls, every one from last night.",
              "The last one asks a question you cannot answer: are you still you?",
              "You step outside, and thirty people turn their empty eyes on you."
            ]
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Dad Behind The Door",
      "goal": "A voice she knows asks to be let in.",
      "target_s": 24,
      "shots": [
        {
          "sequence": {
            "type": "dialogue",
            "setting": "barricade_flat",
            "mood": "tense",
            "seed": 2,
            "a": {
              "k": "you",
              "x": 400
            },
            "b": {
              "k": "dad",
              "x": 700
            },
            "lines": [
              {
                "who": "you",
                "t": "Dad, stop. Say the word mum taught us when we were small."
              },
              {
                "who": "dad",
                "t": "Open the door, sweetheart. My hands are cold and the sun is coming."
              },
              {
                "who": "you",
                "t": "You never called me sweetheart. Not once in twenty three years."
              },
              {
                "who": "dad",
                "t": "Then open it anyway. Everyone else already did, and they are quiet now."
              },
              {
                "who": "you",
                "t": "I'm not opening it. I'm going up to the roof instead."
              }
            ]
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "The Roof At Midnight",
      "goal": "She counts the lights and finds one still burning.",
      "target_s": 24,
      "shots": [
        {
          "sequence": {
            "type": "narration",
            "settings": [
              "rooftop_horde"
            ],
            "mood": "sad",
            "seed": 3,
            "actors": [
              {
                "k": "you",
                "x": 520
              }
            ],
            "crowd": {
              "n": 34,
              "x": [
                0.03,
                0.97
              ],
              "by": [
                0.6,
                0.84
              ],
              "s": [
                0.16,
                0.34
              ],
              "seed": 7,
              "colors": [
                "#49543f",
                "#5c4f42"
              ]
            },
            "cues": [
              "From the roof you can count every window in the district.",
              "Eleven thousand flats, and tonight only one of them still has a lamp on.",
              "Somebody over there is awake, and somebody over there is afraid.",
              "You flash your torch three times, and the far window answers you back.",
              "If that light went out tomorrow, would you still go looking? Tell me."
            ]
          }
        }
      ]
    }
  ]
